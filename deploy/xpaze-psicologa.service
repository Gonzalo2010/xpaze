[Unit]
Description=XPaze: servidor de IA (Paze y explicaciones) en 127.0.0.1:5193
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=gonzalog6
WorkingDirectory=/opt/xpaze
ExecStart=/usr/bin/node --env-file=/opt/xpaze/.env /opt/xpaze/server/psicologa.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
