# Copia este fichero a .env y rellena tus claves. El fichero .env NUNCA se sube al repositorio.
#   node --env-file=.env server/psicologa.js

# IA de texto (explicación del chequeo y Paze): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Voz en directo de Paze (opcional): https://platform.openai.com
OPENAI_API_KEY=

# Clima espacial de la NASA (opcional; sin clave se usa DEMO_KEY, con límite bajo): https://api.nasa.gov
NASA_API_KEY=

# Opcionales
# PSICOLOGA_PORT=5193
# PSICOLOGA_PROVIDER=anthropic        # o «ollama» para un modelo local sin internet
# PSICOLOGA_OLLAMA_MODEL=qwen2.5:3b
# PSICOLOGA_PER_DAY=600               # límite de peticiones al día
